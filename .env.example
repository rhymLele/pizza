NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pizza

# JWT — tối thiểu 32 ký tự, dùng: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m

# Refresh token — dùng secret KHÁC với JWT_SECRET
JWT_REFRESH_SECRET=another-random-string-at-least-32-chars-here
JWT_REFRESH_EXPIRES_IN=7d
